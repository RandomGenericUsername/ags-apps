node_modules/
.venv/
__pycache__/
*.pyc

# build
dist/
target/
build/

# env
.env
.env.local

# os / editor
.DS_Store
.idea/
.vscode/*

# openspec local
openspec/worksets/

# worktrees (ticket harness)
.worktrees/

# Bar typecheck artifacts. `ags types -u` regenerates all of these from the
# GTK/Astal libraries installed on THIS machine: @girs/ is ~49 MB of .d.ts,
# env.d.ts holds the ambient CSS declarations, tsconfig.json is the colliding
# config it overwrites (the committed one is tsconfig.bar.json), and
# node_modules/ holds symlinks into /usr/share/ags/js plus the
# node_modules/ags-platform dev shortcut. They describe the local toolchain,
# not the repo, so they are rebuilt on demand via `make bar-types` /
# `make ags-platform-dev` and never committed.
/bar/node_modules/
/bar/tsconfig.json
/bar/@girs/
/bar/env.d.ts
/bar/tests/node_modules/

# hypr-pano typecheck artifacts: the same machine-generated set as the bar's,
# rebuilt on demand via `make hypr-pano-types` / `make ags-platform-dev` (the
# committed typecheck config is hypr-pano/tsconfig.pano.json).
/hypr-pano/node_modules/
/hypr-pano/tsconfig.json
/hypr-pano/@girs/
/hypr-pano/env.d.ts

# notifications typecheck artifacts: the same machine-generated set as the
# bar's, rebuilt on demand via `make notifications-types` / `make
# ags-platform-dev` (the committed typecheck config is
# notifications/tsconfig.notifications.json). tests/node_modules/ holds the
# on-demand @types/node install.
/notifications/node_modules/
/notifications/tsconfig.json
/notifications/@girs/
/notifications/env.d.ts
/notifications/tests/node_modules/

# capture-tool typecheck artifacts: the same machine-generated set as the bar's,
# rebuilt on demand via `make capture-tool-types` / `make ags-platform-dev` (the
# committed typecheck config is capture-tool/tsconfig.capture.json).
# tests/node_modules/ holds the on-demand @types/node install.
/capture-tool/node_modules/
/capture-tool/tsconfig.json
/capture-tool/@girs/
/capture-tool/env.d.ts
/capture-tool/tests/node_modules/

# The dev-time ags-platform checkout `make ags-platform-dev` fetches on demand
# (pinned, shallow, anonymous). Deliberately OUTSIDE node_modules: Node refuses
# to type-strip `.ts` under a real node_modules dir, but realpaths a symlink,
# so the checkout must live here. A committed copy of the consumed unit would
# defeat AD-17 (consume the published unit, not a vendored one).
/.dev/
